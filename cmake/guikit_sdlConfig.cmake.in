@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(guikit)

if (NOT EMSCRIPTEN)
    find_dependency(Threads)
endif()

if (@GUIKIT_SDL_HAS_TEXT@)
    find_dependency(guikit_text)
endif()

if (@GUIKIT_BUILD_BACKEND_THORVG@ AND NOT @GUIKIT_SDL_BUNDLED_THORVG@)
    find_dependency(thorvg)
endif()

if (@GUIKIT_BUILD_BACKEND_SDL3@ AND NOT @GUIKIT_SDL_BUNDLED_SDL3@)
    find_dependency(SDL3 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/guikitSdlTargets.cmake")
check_required_components(guikit_sdl)
